---
/**
 * Footer — nodo 62:109 y su contenido (154:169..154:231).
 *
 * Medidas del archivo (y=6961..7235, 1440 × 274, fondo #021E46):
 *   logo        x=102 y=6991, 97 × 97
 *   columna 1   x=418 "Menu" + cinco enlaces
 *   columna 2   x=633 "Resources" + cinco enlaces
 *   newsletter  x=856 y=7013 "Subscribe to Newsletter" (Bold 14)
 *   campo       x=856 y=7049, 484 × 34, SOLO borde blanco de 2px,
 *               sin relleno
 *   botón       x=1222 y=7049, 118 × 34, blanco macizo, texto
 *               "Subscribe" en Arboria Bold 14 azul tinta
 *   copyright   x=100 y=7100, dos líneas
 *   privacidad  x=100 y=7163
 *
 * El campo y el botón se solapan en el archivo (856+484 = 1340 y
 * el botón empieza en 1222): el botón va DENTRO del campo, pegado
 * a su borde derecho. Es una sola pieza, no dos cajas contiguas.
 *
 * El form no tiene backend: valida y confirma en cliente. Cambiar
 * `action` cuando exista endpoint.
 */
import { footerColumns, footerMeta, site } from '@/data/site';
---

<footer class="ft" id="contact">
  <div class="ft__inner">
    {/* Logo y bloque legal comparten celda: así el copyright cuelga
        SIEMPRE justo debajo del logo, sin depender de lo que mida
        la columna del newsletter. Antes el legal iba en una segunda
        fila de la rejilla y quedaba muy por debajo de la marca. */}
    <div class="ft__col1">
      {/* Logo real del archivo (154:169), no el marcador dibujado a
          mano: hexágono de la marca con el nombre dentro, 97 × 97. */}
      <a class="ft__brand" href="#main" aria-label={`${site.name} — home`}>
        <img src="/img/logo-light.svg" alt="" width="97" height="97" />
      </a>

      <div class="ft__legal">
        <p class="ft__copy">
          ©{footerMeta.copyrightYear} {footerMeta.copyright}<br />{footerMeta.rights}
        </p>
        <a href={footerMeta.privacy.href} class="ft__link ft__privacy">{footerMeta.privacy.label}</a>
      </div>
    </div>

    {
      footerColumns.map((column) => (
        <nav class="ft__col" aria-labelledby={`ft-${column.title}`}>
          <h2 class="ft__col-title" id={`ft-${column.title}`}>
            {column.title}
          </h2>
          <ul role="list" class="ft__list">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="ft__link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="ft__news">
      <h2 class="ft__col-title" id="newsletter-title">{footerMeta.newsletterTitle}</h2>

      <form class="sub" data-subscribe aria-labelledby="newsletter-title">
        <label class="visually-hidden" for="email">Email address</label>
        <input
          class="sub__input"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
        <button class="sub__btn" type="submit">{footerMeta.subscribeLabel}</button>
      </form>

      <p class="sub__msg" data-subscribe-msg role="status" aria-live="polite"></p>
    </div>

  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
  const msg = document.querySelector<HTMLParagraphElement>('[data-subscribe-msg]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const input = form.querySelector<HTMLInputElement>('#email');

    if (!input?.validity.valid) {
      if (msg) msg.textContent = 'Please enter a valid email address.';
      input?.focus();
      return;
    }

    // Sin backend todavía: confirmamos en cliente y limpiamos.
    if (msg) msg.textContent = 'Thanks — you’re on the list.';
    form.reset();
  });
</script>

<style>
  .ft {
    background-color: var(--brand-ink);
    color: #fff;
    padding-block: clamp(1.75rem, 3vw, 2rem) clamp(1.75rem, 3vw, 2.25rem);
  }

  /* Cuatro bloques en una fila, con los anchos del archivo:
     logo 102, columnas en 418 y 633, newsletter desde 856. */
  .ft__inner {
    display: grid;
    grid-template-columns: auto auto auto minmax(0, 1fr);
    align-items: start;
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    row-gap: clamp(1.5rem, 3vw, 2rem);
    inline-size: min(100% - 2rem, 1241px);
    margin-inline: auto;
  }

  .ft__brand {
    display: block;
    transition: opacity var(--dur-fast) var(--ease-out-quart);
  }

  .ft__brand:hover {
    opacity: 0.82;
  }

  .ft__brand img {
    display: block;
    inline-size: clamp(64px, 6.7vw, 97px);
    block-size: auto;
  }

  /* ---------- COLUMNAS ----------
     14px, blanco, interlineado 1.425. El título en Bold y los
     enlaces en Book: es la única jerarquía que usa el archivo. */
  .ft__col-title {
    font-family: var(--font-display);
    font-size: 0.875rem; /* 14 */
    font-weight: 700;
    line-height: 1.425;
    color: #fff;
  }

  .ft__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ft__link {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.425;
    color: #fff;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .ft__link:hover,
  .ft__link:focus-visible {
    color: var(--accent);
  }

  /* ---------- NEWSLETTER ----------
     Campo de 484 con borde blanco de 2px y el botón blanco de 118
     metido dentro, pegado a la derecha. Sin redondeo. */
  .ft__news {
    justify-self: end;
    inline-size: min(100%, 484px);
  }

  .sub {
    display: flex;
    align-items: stretch;
    margin-block-start: clamp(0.75rem, 1.5vw, 1.125rem);
    block-size: 34px;
    border: 2px solid #fff;
  }

  .sub__input {
    flex: 1;
    min-inline-size: 0;
    padding-inline: 0.625rem;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: #fff;
  }

  .sub:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .sub__btn {
    inline-size: 118px;
    flex-shrink: 0;
    background-color: #fff;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brand-ink);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-quart);
  }

  .sub__btn:hover {
    background-color: var(--brand-sand);
  }

  .sub__msg:empty {
    display: none;
  }

  .sub__msg {
    margin-block-start: 0.5rem;
    font-size: 0.8125rem;
    color: var(--accent-2);
  }

  /* ---------- LEGAL ----------
     12px bajo el logo: en el archivo el logo acaba en y=7088 y el
     copyright empieza en 7100. Al vivir en la misma celda que la
     marca, esa distancia se mantiene aunque el newsletter crezca. */
  .ft__legal {
    margin-block-start: 12px;
  }

  .ft__copy {
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1.425;
    color: #fff;
  }

  /* 23px bajo el copyright: el bloque acaba en y=7140 y "Privacy
     Policy" empieza en 7163. */
  .ft__privacy {
    display: inline-block;
    margin-block-start: 23px;
  }

  @media (width < 62rem) {
    .ft__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ft__news {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (width < 34rem) {
    .ft__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
