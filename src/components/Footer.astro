---
/**
 * Footer — logo, columnas de enlaces y suscripción al newsletter.
 * El form no tiene backend todavía: hace su propia validación y
 * confirma en cliente. Cambiar `action` cuando exista endpoint.
 */
import Logo from '@components/Logo.astro';
import { footerColumns, site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="wrap wrap--wide footer__grid">
    <div class="footer__brand">
      <Logo tone="light" />
      <p class="footer__tagline">{site.positioning}</p>
    </div>

    {
      footerColumns.map((column) => (
        <nav class="footer__col" aria-labelledby={`footer-${column.title}`}>
          <h2 class="footer__col-title" id={`footer-${column.title}`}>
            {column.title}
          </h2>
          <ul role="list" class="footer__list">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="footer__news">
      <h2 class="footer__col-title" id="newsletter-title">Subscribe</h2>
      <p class="footer__news-copy">
        Get the systems, frameworks and numbers behind agencies scaling past
        7 figures — straight to your inbox.
      </p>

      <form class="subscribe" data-subscribe aria-labelledby="newsletter-title">
        <label class="visually-hidden" for="email">Email address</label>
        <input
          class="subscribe__input"
          type="email"
          id="email"
          name="email"
          placeholder="Enter your email"
          autocomplete="email"
          required
        />
        <button class="subscribe__btn" type="submit">
          <span class="visually-hidden">Subscribe</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </form>

      <p class="subscribe__msg" data-subscribe-msg role="status" aria-live="polite"></p>
    </div>
  </div>

  <div class="wrap wrap--wide footer__base">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <ul role="list" class="footer__meta">
      <li><a href="/llms.txt" class="footer__link">llms.txt</a></li>
      <li><a href="/catalog.txt" class="footer__link">catalog.txt</a></li>
    </ul>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-subscribe]');
  const msg = document.querySelector<HTMLParagraphElement>('[data-subscribe-msg]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const input = form.querySelector<HTMLInputElement>('#email');

    if (!input?.validity.valid) {
      if (msg) msg.textContent = 'Please enter a valid email address.';
      input?.focus();
      return;
    }

    // Sin backend todavía: confirmamos en cliente y limpiamos.
    if (msg) msg.textContent = 'Thanks — you’re on the list.';
    form.reset();
  });
</script>

<style>
  .footer {
    padding-block: var(--space-2xl) var(--space-l);
    background-color: var(--brand-ink);
    color: var(--n-0);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.6fr;
    gap: var(--space-xl) var(--space-l);
    padding-block-end: var(--space-xl);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-s);
  }

  .footer__tagline {
    font-size: var(--step--1);
    color: oklch(from var(--n-0) l c h / 0.62);
    max-inline-size: 26ch;
  }

  .footer__col-title {
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
    margin-block-end: var(--space-s);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    font-size: var(--step--1);
    color: oklch(from var(--n-0) l c h / 0.72);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--accent);
  }

  .footer__news-copy {
    font-size: var(--step--1);
    color: oklch(from var(--n-0) l c h / 0.62);
    max-inline-size: 40ch;
    margin-block-end: var(--space-s);
  }

  /* Input y botón en una sola pieza: el botón vive dentro del
     borde del campo, no al lado. Menos ruido visual. */
  .subscribe {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: 0.35rem 0.35rem 0.35rem var(--space-s);
    border-radius: var(--radius-full);
    border: 1px solid oklch(from var(--n-0) l c h / 0.20);
    background-color: oklch(from var(--n-0) l c h / 0.05);
    max-inline-size: 24rem;
    transition: border-color var(--dur-fast) var(--ease-out-quart);
  }

  .subscribe:focus-within {
    border-color: var(--accent);
  }

  .subscribe__input {
    flex: 1;
    min-inline-size: 0;
    border: none;
    background: none;
    outline: none;
    font-size: var(--step--1);
    color: var(--n-0);
  }

  .subscribe__input::placeholder {
    color: oklch(from var(--n-0) l c h / 0.42);
  }

  .subscribe__btn {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    color: var(--accent-ink);
    transition:
      background-color var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-fast) var(--ease-spring);
  }

  .subscribe__btn svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .subscribe__btn:hover {
    background-color: var(--accent-hover);
    transform: scale(1.06);
  }

  .subscribe__msg:empty {
    display: none;
  }

  .subscribe__msg {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--2);
    color: var(--accent);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid oklch(from var(--n-0) l c h / 0.12);
    font-size: var(--step--2);
    color: oklch(from var(--n-0) l c h / 0.52);
  }

  .footer__meta {
    display: flex;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 62rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand,
    .footer__news {
      grid-column: 1 / -1;
    }
  }

  @media (width < 34rem) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }
</style>
