---
/**
 * Stats band — "Ready to find your tribe?", imagen con botón de play,
 * y las cuatro cifras de resultados.
 */
import { stats } from '@/data/site';
---

<section class="stats" id="success-stories" aria-labelledby="stats-heading">
  <div class="wrap wrap--wide stack stack--xl">
    <header class="stats__header">
      <p class="stats__eyebrow" data-animate="fade-up">{stats.eyebrowDisplay}</p>
      <h2 class="stats__heading" id="stats-heading" data-animate="fade-up" data-delay="0.06">
        {stats.headingLead}{' '}
        <em class="stats__accent">{stats.headingAccent}</em>
      </h2>
    </header>

    <figure class="stats__media" data-animate="reveal">
      <img
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1600&q=70"
        alt="Members of a creative agency team collaborating around a table during a working session"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />

      <button type="button" class="stats__play" data-play>
        <span class="visually-hidden">Play the Creative Agency Success community video</span>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M9 6.5v11a.6.6 0 0 0 .92.5l8.2-5.5a.6.6 0 0 0 0-1l-8.2-5.5A.6.6 0 0 0 9 6.5Z" />
        </svg>
      </button>
    </figure>

    <dl class="stats__figures" data-animate="stagger" data-stagger="0.09">
      {
        stats.figures.map((figure) => (
          <div class="stat">
            <dt class="stat__value">{figure.value}</dt>
            <dd class="stat__label">{figure.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    padding-block: var(--space-3xl);
    background-color: var(--surface);
  }

  .stats__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    text-align: center;
  }

  .stats__eyebrow {
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
  }

  .stats__heading {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    max-inline-size: 20ch;
  }

  /* El acento va en cursiva y en color: separa las dos mitades
     del concepto sin necesitar un salto de línea forzado. */
  .stats__accent {
    color: var(--accent);
    font-style: italic;
  }

  .stats__media {
    position: relative;
    margin: 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    aspect-ratio: 16 / 8;
    background-color: var(--surface-sunk);
  }

  .stats__media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .stats__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      oklch(from var(--brand-ink) l c h / 0.55),
      transparent 55%
    );
    pointer-events: none;
  }

  .stats__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 5rem;
    block-size: 5rem;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    color: var(--accent-ink);
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .stats__play svg {
    inline-size: 1.8rem;
    block-size: 1.8rem;
    translate: 2px 0;
  }

  /* Anillo pulsante — atrae el ojo al play sin animar el botón */
  .stats__play::before {
    content: '';
    position: absolute;
    inset: -0.5rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--accent);
    opacity: 0;
    animation: pulse-ring 2.8s var(--ease-out-quart) infinite;
  }

  .stats__play:hover {
    transform: scale(1.08);
  }

  @keyframes pulse-ring {
    0%   { opacity: 0.7; transform: scale(0.9); }
    70%  { opacity: 0;   transform: scale(1.25); }
    100% { opacity: 0;   transform: scale(1.25); }
  }

  .stats__figures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--accent);
  }

  .stat__value {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    color: var(--brand-ink);
  }

  .stat__label {
    margin: 0;
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--ink-muted);
  }

  @media (width < 62rem) {
    .stats__figures {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-l) var(--space-m);
    }

    .stats__play {
      inline-size: 4rem;
      block-size: 4rem;
    }

    .stats__play svg {
      inline-size: 1.4rem;
      block-size: 1.4rem;
    }
  }

  @media (width < 34rem) {
    .stats__figures {
      grid-template-columns: 1fr;
    }

    .stats__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
