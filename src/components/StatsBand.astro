---
/**
 * Banda de datos — nodos 42:73, 42:74, 89:441 (media + play) y los
 * cuatro grupos 135:108..111 del Figma.
 *
 * Del archivo:
 *   titular   "Ready to find your tribe?"  centrado, 1241 de ancho
 *   subtítulo "Individual Clarity and Collective Confidence"
 *   media     922 × 492 con velo negro al 25% y triángulo de play
 *             (Polygon 2, 83 × 79, rotado 90°)
 *   cifras    Arboria Medium 32 / #8686F2  (púrpura)
 *   etiquetas Arboria Book 20 / #021E46    (azul tinta)
 *
 * Estructura real: la media ocupa la izquierda y las cuatro cifras
 * se apilan en vertical a la derecha, separadas 140px. No es una
 * fila de cuatro, que es como estaba antes.
 */
import Picture from '@components/Picture.astro';
import { stats } from '@/data/site';
---

<section class="stats" id="about" aria-labelledby="stats-heading">
  <div class="stats__inner">
    <header class="stats__head">
      <h2 class="stats__title" id="stats-heading" data-animate="fade-up">
        {stats.eyebrowDisplay}
      </h2>
      <p class="stats__sub" data-animate="fade-up" data-delay="0.06">
        {stats.subheading}
      </p>
    </header>

    <div class="stats__body">
      <figure class="stats__media" data-animate="reveal">
        <Picture src={stats.media.src} alt={stats.media.alt} width={1844} height={984} />
        <button class="stats__play" type="button" data-play>
          <span class="visually-hidden">Play the Creative Agency Success community video</span>
          <svg viewBox="0 0 79 83" fill="none" aria-hidden="true">
            <path d="M39.5 2 77 81H2L39.5 2Z" fill="white" transform="rotate(90 39.5 41.5)" />
          </svg>
        </button>
      </figure>

      <dl class="stats__figures" data-animate="stagger" data-stagger="0.09">
        {
          stats.figures.map((f) => (
            <div class="stats__figure">
              <dt class="stats__value">{f.value}</dt>
              <dd class="stats__label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Fondo del archivo (Rectangle 10, 42:72): banda arena #F4F1EF
     cuyo borde superior NO es horizontal — cae unos 20px de
     izquierda a derecha sobre 1440 de ancho. Faltaba por completo:
     la sección estaba sobre blanco.

     Va con clip-path y no con el SVG exportado a propósito. El
     export tiene una proporción fija de 1440 × 842; al estirarlo a
     una ventana más ancha o más estrecha, el ángulo del corte
     cambia. Con clip-path el corte mantiene su ALTURA en píxeles a
     cualquier ancho, que es lo que hace que se lea igual en 1280 y
     en 2560. La geometría es una diagonal de dos puntos: se
     reproduce exacta, no es un glifo del que falte información. */
  .stats {
    position: relative;
    background-color: var(--brand-sand);
    padding-block: clamp(4rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5.5rem);
  }

  .stats::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    /* Alto del corte diagonal en el archivo, proporcional al ancho */
    block-size: clamp(28px, 3vw, 44px);
    background-color: var(--surface);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 42%);
    pointer-events: none;
  }

  .stats__inner {
    position: relative;
    inline-size: min(100% - 2rem, 1241px);
    margin-inline: auto;
  }

  .stats__head {
    text-align: center;
    margin-block-end: clamp(2rem, 4vw, 3.25rem);
  }

  .stats__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--brand-ink);
  }

  /* Work Sans 20/30 con -0.4 de tracking, gris. Exacto del archivo:
     no va en púrpura ni en negrita. */
  .stats__sub {
    margin-block-start: clamp(0.5rem, 1vw, 0.875rem);
    font-size: 1.25rem;
    line-height: 1.5;
    letter-spacing: -0.4px;
    color: var(--brand-slate);
  }

  /* ---------- CUERPO ---------- */

  .stats__body {
    display: grid;
    grid-template-columns: minmax(0, 922fr) minmax(0, 299fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .stats__media {
    position: relative;
    margin: 0;
    aspect-ratio: 922 / 492;
    overflow: hidden;
  }

  .stats__media :global(picture),
  .stats__media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Velo del 25%: es lo que deja respirar al triángulo blanco
     sobre una foto clara. */
  .stats__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.25);
    pointer-events: none;
  }

  .stats__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    z-index: 1;
    inline-size: clamp(48px, 5.8vw, 83px);
    aspect-ratio: 83 / 79;
    display: grid;
    place-items: center;
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .stats__play svg {
    inline-size: 100%;
    block-size: 100%;
    filter: drop-shadow(0 4px 16px rgb(0 0 0 / 0.28));
  }

  .stats__play:hover {
    transform: scale(1.1);
  }

  /* ---------- CIFRAS ---------- */

  .stats__figures {
    display: flex;
    flex-direction: column;
    /* 140px entre inicios de cifra, menos los ~99 que ocupa cada
       bloque, deja unos 41 de aire. */
    gap: clamp(1.5rem, 2.6vw, 2.5625rem);
    margin: 0;
  }

  .stats__figure {
    max-inline-size: 299px;
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.4vw, 2rem); /* 32px */
    font-weight: 500;
    line-height: 1.2;
    color: var(--accent);
  }

  .stats__label {
    margin: 0.25rem 0 0;
    font-size: clamp(1rem, 1.35vw, 1.25rem); /* 20px */
    line-height: 1.28;
    color: var(--brand-ink);
    max-inline-size: 205px;
  }

  @media (width < 62rem) {
    .stats__body {
      grid-template-columns: 1fr;
    }

    .stats__figures {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(1.5rem, 4vw, 2.5rem);
    }

    .stats__figure,
    .stats__label {
      max-inline-size: none;
    }
  }

  @media (width < 34rem) {
    .stats__figures {
      grid-template-columns: 1fr;
    }
  }
</style>
