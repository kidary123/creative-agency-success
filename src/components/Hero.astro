---
/**
 * Hero — headline, sub-copy, línea de posicionamiento, CTA y gráfico.
 * El gráfico es un SVG propio: placeholder honesto mientras no
 * podamos exportar el asset del Figma. Se reemplaza cambiando
 * solo el bloque .hero__figure.
 */
import { hero } from '@/data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__glow" aria-hidden="true" data-parallax="0.08"></div>

  <div class="wrap wrap--wide hero__grid">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-heading" data-animate="fade-up">
        {hero.headlineDisplay}
      </h1>

      <p class="hero__sub" data-animate="fade-up" data-delay="0.08">
        {hero.subcopy}
      </p>

      <p class="hero__kicker" data-animate="fade-up" data-delay="0.14">
        {hero.kicker}
      </p>

      <div class="hero__actions" data-animate="fade-up" data-delay="0.2">
        <a href={hero.cta.href} class="btn btn--accent btn--lg">
          <span>{hero.cta.label}</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>

    <div class="hero__figure" data-animate="reveal" data-delay="0.18">
      <!-- Gráfico de crecimiento: la promesa del producto, dibujada. -->
      <svg viewBox="0 0 420 380" role="img" aria-labelledby="hero-graphic-title" class="hero__svg">
        <title id="hero-graphic-title">
          Illustration of an agency growth curve rising across four quarterly bars
        </title>

        <defs>
          <linearGradient id="barFill" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.25" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.95" />
          </linearGradient>
          <linearGradient id="areaFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
        </defs>

        <rect x="8" y="8" width="404" height="364" rx="24" class="hero__panel" />

        <!-- Retícula -->
        <g class="hero__grid-lines">
          <line x1="48" y1="92"  x2="380" y2="92" />
          <line x1="48" y1="160" x2="380" y2="160" />
          <line x1="48" y1="228" x2="380" y2="228" />
          <line x1="48" y1="296" x2="380" y2="296" />
        </g>

        <!-- Barras trimestrales -->
        <g fill="url(#barFill)">
          <rect x="72"  y="238" width="46" height="58"  rx="8" />
          <rect x="146" y="196" width="46" height="100" rx="8" />
          <rect x="220" y="140" width="46" height="156" rx="8" />
          <rect x="294" y="72"  width="46" height="224" rx="8" />
        </g>

        <!-- Curva de crecimiento -->
        <path
          d="M95 238 L169 196 L243 140 L317 72 L317 296 L95 296 Z"
          fill="url(#areaFill)"
        />
        <path
          d="M95 238 L169 196 L243 140 L317 72"
          fill="none"
          stroke="var(--accent)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hero__line"
        />

        <g class="hero__dots">
          <circle cx="95"  cy="238" r="5" />
          <circle cx="169" cy="196" r="5" />
          <circle cx="243" cy="140" r="5" />
          <circle cx="317" cy="72"  r="7" class="hero__dot--last" />
        </g>

        <line x1="48" y1="296" x2="380" y2="296" class="hero__axis" />
      </svg>

      <!-- Píldora flotante: el detalle que hace que el bloque no se
           lea como un gráfico genérico de stock. -->
      <div class="hero__pill">
        <span class="hero__pill-value">897%</span>
        <span class="hero__pill-label">Revenue increase<br />in 9 months</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--brand-ink);
    color: var(--n-0);
    padding-block: calc(var(--space-4xl) + var(--space-l)) var(--space-3xl);
    overflow: clip;
  }

  .hero__glow {
    position: absolute;
    inset-block-start: -30%;
    inset-inline-end: -10%;
    inline-size: min(90vw, 46rem);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: radial-gradient(circle at center, var(--accent-soft) 0%, transparent 64%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-2xl);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-s);
  }

  .hero__title {
    font-size: var(--step-7);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    max-inline-size: 14ch;
  }

  .hero__sub {
    font-size: var(--step-0);
    line-height: var(--leading-normal);
    color: oklch(from var(--n-0) l c h / 0.74);
    max-inline-size: 52ch;
  }

  /* La línea de posicionamiento merece peso propio: es el
     argumento de venta comprimido en ocho palabras. */
  .hero__kicker {
    position: relative;
    padding-inline-start: var(--space-s);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--n-0);
  }

  .hero__kicker::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block: 0.15em;
    inline-size: 3px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
  }

  .hero__actions {
    margin-block-start: var(--space-2xs);
  }

  .hero__figure {
    position: relative;
  }

  .hero__svg {
    inline-size: 100%;
    block-size: auto;
  }

  .hero__panel {
    fill: oklch(from var(--n-0) l c h / 0.04);
    stroke: oklch(from var(--n-0) l c h / 0.10);
    stroke-width: 1;
  }

  .hero__grid-lines line,
  .hero__axis {
    stroke: oklch(from var(--n-0) l c h / 0.10);
    stroke-width: 1;
  }

  .hero__dots circle {
    fill: var(--brand-ink);
    stroke: var(--accent);
    stroke-width: 3;
  }

  .hero__dot--last {
    fill: var(--accent);
  }

  .hero__pill {
    position: absolute;
    inset-block-end: 8%;
    inset-inline-start: -4%;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-m);
    background-color: var(--n-0);
    color: var(--brand-ink);
    box-shadow: var(--shadow-l);
  }

  .hero__pill-value {
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    color: var(--brand-ink);
  }

  .hero__pill-label {
    font-size: var(--step--2);
    font-weight: 500;
    line-height: 1.25;
    color: var(--n-600);
  }

  @media (width < 62rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .hero__title {
      max-inline-size: 18ch;
    }

    .hero__figure {
      max-inline-size: 30rem;
    }
  }

  @media (width < 34rem) {
    .hero {
      padding-block: calc(var(--space-4xl)) var(--space-2xl);
    }

    .hero__pill {
      inset-inline-start: 0;
      inset-block-end: 2%;
    }
  }
</style>
