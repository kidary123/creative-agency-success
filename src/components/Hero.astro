---
/**
 * Hero — reconstruido desde el Figma (nodos 82:49, 175:447, 34:3,
 * 38:168 y el gráfico 1295:1833).
 *
 * Medidas del archivo, lienzo 1440 × 596 (banda y=100..696):
 *   banda        #F4F1EF
 *   h1           x=110  y=308  574 × 158
 *   subcopy      x=110  y=479  475 × 134
 *   CTA          x=110  y=656  195 × 59
 *   gráfico      x=750  y=257  580 × 438
 *   kicker       y=715  498 × 36
 *
 * El gráfico es el heptágono de valores: siete vértices etiquetados
 * (Purpose, Confidence, Control, Growth, Freedom, Fulfilment,
 * Passion) con las formas superpuestas y el recorte fotográfico
 * encima. "Confidence" va en Bold y azul tinta; el resto en Book
 * gris — es la única palabra que el diseño destaca, y coincide con
 * "Collective Confidence" de la banda de datos.
 */
import Picture from '@components/Picture.astro';
import { hero } from '@/data/site';

/** Vértices del heptágono, en el orden en que aparecen en el Figma. */
const vertices = [
  { label: 'Purpose', pos: 'purpose' },
  { label: 'Confidence', pos: 'confidence', strong: true },
  { label: 'Control', pos: 'control' },
  { label: 'Growth', pos: 'growth' },
  { label: 'Freedom', pos: 'freedom' },
  { label: 'Fulfilment', pos: 'fulfilment' },
  { label: 'Passion', pos: 'passion' },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-heading" data-animate="fade-up">
        {hero.headlineDisplay}
      </h1>

      <p class="hero__sub" data-animate="fade-up" data-delay="0.08">
        {hero.subcopy}
      </p>

      <div data-animate="fade-up" data-delay="0.16">
        <a href={hero.cta.href} class="hero__cta">
          {hero.cta.label}
        </a>
      </div>
    </div>

    <div class="hero__figure" data-animate="reveal" data-delay="0.14">
      <div class="hero__chart">
        <img class="hero__heptagon" src="/img/hero-heptagon.svg" alt="" width="580" height="438" aria-hidden="true" />
        <img class="hero__shapes" src="/img/hero-shapes.svg" alt="" width="580" height="438" aria-hidden="true" />
        {/* El export original pesaba 3.2 MB a 2000px. Reescalado a 2x
            del tamaño de render y servido en WebP (149 KB): es la
            imagen del LCP, no puede costar megas. */}
        <Picture
          class="hero__person"
          src="/img/hero-person.png"
          alt="A creative agency owner standing with open arms at the centre of the seven values the programme builds"
          width={1160}
          height={1086}
          loading="eager"
          fetchpriority="high"
        />

        {
          vertices.map((v) => (
            <span class:list={['hero__vertex', `hero__vertex--${v.pos}`, v.strong && 'is-strong']}>
              {v.label}
            </span>
          ))
        }
      </div>
    </div>

    {/* En el archivo el kicker está en x=775..1273: centrado bajo la
        columna del gráfico, no bajo el titular. Por eso vive dentro
        de la rejilla del hero, en la segunda columna. */}
    <p class="hero__kicker" data-animate="fade-up" data-delay="0.24">
      {hero.kickerLead} <strong>{hero.kickerStrong}</strong>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--brand-sand);
    color: var(--brand-ink);
    padding-block: clamp(2.5rem, 5vw, 4.25rem) clamp(2.5rem, 4vw, 3.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 574fr) minmax(0, 580fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.75rem);
    inline-size: min(100% - 2rem, 1220px);
    margin-inline: auto;
  }

  /* El contenido y el gráfico ocupan la fila 1; el kicker cuelga de
     la segunda columna en la fila 2. */
  .hero__content { grid-column: 1; grid-row: 1; }
  .hero__figure  { grid-column: 2; grid-row: 1; }
  .hero__kicker  { grid-column: 2; grid-row: 2; }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: clamp(1.25rem, 2vw, 1.75rem);
  }

  /* 158px de alto para dos líneas en 574 de ancho ⇒ ~64/72.
     Se traduce a una escala fluida con el mismo tope. */
  .hero__title {
    font-size: clamp(2.5rem, 4.4vw, 4rem);
    font-weight: 700;
    line-height: 1.13;
    letter-spacing: -0.02em;
    color: var(--brand-ink);
    max-inline-size: 14ch;
  }

  .hero__sub {
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    line-height: 1.65;
    color: var(--brand-slate);
    max-inline-size: 30rem;
  }

  /* ---------- GRÁFICO ---------- */

  .hero__figure {
    position: relative;
  }

  .hero__chart {
    position: relative;
    inline-size: 100%;
    max-inline-size: 580px;
    margin-inline: auto;
    aspect-ratio: 580 / 438;
  }

  .hero__heptagon,
  .hero__shapes,
  .hero__person {
    position: absolute;
    max-inline-size: none;
  }

  /* Insets exactos del Figma, en porcentaje sobre el contenedor */
  .hero__heptagon {
    inset: 7.31% 12.85% 0.02% 15.18%;
    inline-size: 71.97%;
    block-size: 92.67%;
  }

  .hero__shapes {
    inset: 7.08% 12.7% 0 15.18%;
    inline-size: 72.12%;
    block-size: 92.92%;
  }

  .hero__person {
    inset: 16.67% 15.29% 0 17.77%;
    inline-size: 66.94%;
    block-size: 83.33%;
  }

  .hero__person :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    object-position: bottom;
  }

  /* ---------- ETIQUETAS DE LOS VÉRTICES ----------
     Posicionadas con los mismos insets que el archivo. */
  .hero__vertex {
    position: absolute;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--brand-slate);
    white-space: nowrap;
  }

  .hero__vertex.is-strong {
    font-weight: 700;
    color: var(--brand-ink);
  }

  .hero__vertex--purpose    { inset-block-start: 0;      inset-inline-start: 44.1%; }
  .hero__vertex--confidence { inset-block-start: 23.74%; inset-inline-start: 83.61%; }
  .hero__vertex--control    { inset-block-start: 64.03%; inset-inline-start: 88.95%; }
  .hero__vertex--growth     { inset-block-start: 91.88%; inset-inline-start: 79.21%; }
  .hero__vertex--freedom    { inset-block-start: 90.87%; inset-inline-start: 3.56%; }
  .hero__vertex--fulfilment { inset-block-start: 63.54%; inset-inline-start: 0; }
  .hero__vertex--passion    { inset-block-start: 23.41%; inset-inline-start: 7.08%; }

  /* ---------- CTA ----------
     Component 1 del archivo: verde con texto azul tinta, 195 × 59 y
     sin redondeo. */
  .hero__cta {
    display: inline-grid;
    place-items: center;
    inline-size: 195px;
    min-block-size: 59px;
    max-inline-size: 100%;
    padding-inline: 1rem;
    background-color: var(--accent-2);
    font-family: var(--font-display);
    font-size: 1.25rem; /* 20 */
    font-weight: 500;
    color: var(--brand-ink);
    transition:
      filter var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .hero__cta:hover {
    filter: brightness(1.06);
    transform: translateY(-2px);
  }

  /* ---------- KICKER ----------
     Arboria 24/28 azul tinta, centrado en un ancho de 498 bajo el
     gráfico. Dos pesos: la primera frase en Book y la segunda en
     Medium — el diseño acentúa la promesa, no la premisa. */
  .hero__kicker {
    justify-self: center;
    inline-size: min(100%, 498px);
    margin-block-start: clamp(1rem, 2vw, 1.25rem);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.67vw, 1.5rem); /* 24 */
    font-weight: 400;
    line-height: 1.167; /* 28/24 */
    text-align: center;
    color: var(--brand-ink);
  }

  .hero__kicker strong {
    font-weight: 500;
  }

  @media (width < 62rem) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 6vw, 3rem);
    }

    /* En una sola columna el orden manda sobre las coordenadas del
       archivo: contenido, gráfico y kicker al final. */
    .hero__content { grid-column: 1; grid-row: 1; }
    .hero__figure  { grid-column: 1; grid-row: 2; }
    .hero__kicker  { grid-column: 1; grid-row: 3; }

    .hero__content {
      align-items: center;
      text-align: center;
    }

    .hero__title {
      max-inline-size: 18ch;
    }
  }

  @media (width < 34rem) {
    .hero__vertex {
      font-size: 0.75rem;
    }
  }
</style>
