---
/**
 * Program cards — las dos ofertas lado a lado.
 * Cada tarjeta es un <article> con su propio heading: así un
 * crawler las lee como dos entidades separadas, en línea con
 * los dos Service/Offer del JSON-LD.
 */
import { programs } from '@/data/site';
---

<section class="programs" id="programs" aria-labelledby="programs-heading">
  <div class="wrap wrap--wide stack stack--l">
    <header class="programs__header">
      <h2 class="programs__heading" id="programs-heading" data-animate="fade-up">
        Paths To Success
      </h2>
      <p class="programs__sub" data-animate="fade-up" data-delay="0.06">
        Two programs, separated by the stage of your agency and the problem
        you are actually facing.
      </p>
    </header>

    <div class="programs__grid">
      {
        programs.map((program, index) => (
          <article
            class="card"
            id={program.id}
            aria-labelledby={`${program.id}-title`}
            data-animate="fade-up"
            data-delay={index * 0.1}
          >
            <p class="card__badge">{program.badge}</p>

            <h3 class="card__title" id={`${program.id}-title`}>
              {program.nameDisplay}
            </h3>

            <p class="card__body">{program.body}</p>

            <a href={program.cta.href} class="btn btn--dark card__cta">
              <span>{program.cta.label}</span>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs {
    padding-block: var(--space-3xl);
    background-color: var(--surface-alt);
  }

  .programs__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    text-align: center;
  }

  .programs__heading {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .programs__sub {
    font-size: var(--step-0);
    color: var(--ink-muted);
    max-inline-size: 48ch;
  }

  .programs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-s);
    padding: var(--space-l);
    border-radius: var(--radius-l);
    background-color: var(--surface);
    border: 1px solid var(--line);
    transition:
      transform var(--dur-base) var(--ease-out-expo),
      border-color var(--dur-base) var(--ease-out-quart),
      box-shadow var(--dur-base) var(--ease-out-expo);
  }

  /* Barra de acento que crece desde la izquierda al hover.
     Cuesta cuatro líneas y hace que la tarjeta se sienta viva. */
  .card::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--space-l);
    inline-size: 3rem;
    block-size: 3px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease-out-expo);
  }

  .card {
    position: relative;
    overflow: hidden;
  }

  .card:hover::before {
    transform: scaleX(1);
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-l);
  }

  .card__badge {
    display: inline-flex;
    padding: 0.45em 1em;
    border-radius: var(--radius-full);
    background-color: var(--accent-soft);
    color: var(--brand-ink);
    font-size: var(--step--2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .card__title {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
  }

  .card__body {
    font-size: var(--step-0);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  .card__cta {
    margin-block-start: auto;
  }

  @media (width < 56rem) {
    .programs__grid {
      grid-template-columns: 1fr;
    }

    .card {
      padding: var(--space-m);
    }
  }
</style>
