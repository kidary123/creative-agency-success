---
/**
 * Program cards — nodos 53:49, 53:50, 57:631..650 y 170:423 del Figma.
 *
 * Anatomía de cada card, medidas del archivo:
 *   bloque de arte    612 × 418, púrpura #8686F2 o verde #32E0A5,
 *                     con una ilustración de polígonos superpuestos
 *   insignia          círculo de 130, solapando la esquina inferior
 *                     derecha del bloque; color cruzado respecto al
 *                     bloque (verde sobre púrpura y viceversa)
 *   barra de título   611 × 76, azul tinta #021E46,
 *                     Arboria Medium 36 en blanco, centrado
 *   cuerpo            Work Sans 18/30, tracking -0.36px, #4D4D4D
 *   CTA               195 × 59, púrpura, "Get Started", esquinas
 *                     rectas — el diseño no redondea este botón
 *
 * El cruce de color de la insignia lo deduje del archivo: en Scale
 * Partnership el bloque es verde y la insignia púrpura. Aplico el
 * mismo criterio invertido a Agency Accelerator.
 */
import { programs } from '@/data/site';
---

<section class="programs" id="programs" aria-labelledby="programs-heading">
  <h2 class="visually-hidden" id="programs-heading">Our programs</h2>

  <div class="programs__grid">
    {
      programs.map((p, i) => (
        <article
          class:list={['card', `card--${p.tone}`]}
          id={p.id}
          data-animate="fade-up"
          data-delay={i * 0.1}
          aria-labelledby={`${p.id}-title`}
        >
          <div class="card__art">
            <img src={p.art} alt="" width="386" height="341" aria-hidden="true" loading="lazy" />
            <span class="card__badge">
              <span>{p.badgeTop}</span>
              <span>{p.badgeBottom}</span>
            </span>
          </div>

          <h3 class="card__title" id={`${p.id}-title`}>
            {p.nameDisplay}
          </h3>

          <div class="card__body">
            {p.body.split('\n\n').map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <a href={p.cta.href} class="card__cta">
            {p.cta.label}
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .programs {
    background-color: var(--surface);
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .programs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 3rem);
    inline-size: min(100% - 2rem, 1241px);
    margin-inline: auto;
    align-items: start;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  /* ---------- BLOQUE DE ARTE ---------- */

  .card__art {
    position: relative;
    aspect-ratio: 612 / 418;
    display: grid;
    place-items: center;
    overflow: visible;
  }

  .card--purple .card__art { background-color: var(--accent); }
  .card--green  .card__art { background-color: var(--accent-2); }

  .card__art img {
    inline-size: 63%;
    block-size: auto;
    max-block-size: 82%;
    object-fit: contain;
  }

  /* Insignia: solapa la esquina, medio dentro medio fuera. Es el
     detalle que ata el bloque de color con la barra de título. */
  .card__badge {
    position: absolute;
    inset-block-end: -7.7%;
    inset-inline-end: 5%;
    z-index: 2;
    display: grid;
    place-content: center;
    inline-size: clamp(84px, 10.5vw, 130px);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.65vw, 1.5rem); /* 24px */
    font-weight: 500;
    line-height: 1.16;
    text-align: center;
    color: #fff;
  }

  .card--purple .card__badge { background-color: var(--accent-2); color: var(--brand-ink); }
  .card--green  .card__badge { background-color: var(--accent); }

  /* ---------- TÍTULO ---------- */

  .card__title {
    display: grid;
    place-items: center;
    min-block-size: clamp(56px, 5.3vw, 76px);
    padding: 0.5rem clamp(5rem, 12%, 8rem) 0.5rem 1rem;
    background-color: var(--brand-ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem); /* 36px */
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    color: #fff;
  }

  /* ---------- CUERPO ---------- */

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 1.875rem; /* el hueco de 30px entre párrafos del archivo */
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
    font-size: 1.125rem;  /* 18px */
    line-height: 1.667;   /* 30/18 */
    letter-spacing: -0.36px;
    color: var(--brand-slate);
    flex: 1;
  }

  /* ---------- CTA ----------
     Rectangular a propósito: el diseño no redondea este botón,
     a diferencia del CTA del hero. */
  .card__cta {
    display: grid;
    place-items: center;
    inline-size: 195px;
    min-block-size: 59px;
    max-inline-size: 100%;
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
    padding-inline: 1rem;
    background-color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.25rem; /* 20px */
    font-weight: 500;
    color: #fff;
    transition:
      background-color var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-base) var(--ease-out-expo);
  }

  .card__cta:hover {
    background-color: var(--accent-hover);
    transform: translateY(-2px);
  }

  @media (width < 56rem) {
    .programs__grid {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 6vw, 3.5rem);
    }

    .card__title {
      padding-inline: 1rem clamp(5rem, 22%, 7rem);
    }
  }
</style>
