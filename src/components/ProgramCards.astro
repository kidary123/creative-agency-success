---
/**
 * Program cards — Group 48 (170:425) y Group 47 (170:423) del Figma.
 *
 * Anatomía real de cada card, medidas del archivo:
 *   bloque de arte    612 × 418, púrpura #8686F2 o verde #32E0A5
 *   arte              DOS polígonos superpuestos, no un dibujo plano:
 *                       Accelerator  rayas blancas + contorno verde
 *                       Partnership  masa azul palidísima + contorno
 *                                    púrpura
 *   insignia          círculo de 130 en color contrario, top 74.4%
 *                     del bloque y 23px del borde derecho; pisa la
 *                     barra de título. Texto Arboria Medium 24 en dos
 *                     líneas con interlineado 82.9%
 *   barra de título   611 × 76, azul tinta, Arboria Medium 36 blanco
 *   cuerpo            Work Sans 18/30, tracking -0.36, #4D4D4D
 *   CTA               195 × 59, sin redondeo, color CONTRARIO al del
 *                     bloque: verde en Accelerator, púrpura en
 *                     Partnership
 *
 * ---------- EL HOVER ----------
 * El archivo trae una segunda variante de cada componente de arte
 * (138:143 y 138:193). Comparando ambas se ve qué cambia: las dos
 * capas GIRAN EN SENTIDOS OPUESTOS y crecen un poco. No es un
 * fundido ni un desplazamiento.
 *
 *   Accelerator  rayas −7.21°   contorno +6.97°
 *   Partnership  masa  −5.68°   contorno +8.74°
 *
 * Los ángulos salen de restar la rotación de la variante por defecto
 * a la de la variante 2 (en Partnership las dos parten de 90°, por
 * eso 84.32 y 98.74 se traducen a −5.68 y +8.74).
 */
import { programs } from '@/data/site';
---

<section class="programs" id="programs" aria-labelledby="programs-heading">
  <h2 class="visually-hidden" id="programs-heading">Our programs</h2>

  <div class="programs__grid">
    {
      programs.map((p, i) => (
        <article
          class:list={['card', `card--${p.tone}`]}
          id={p.id}
          data-animate="fade-up"
          data-delay={i * 0.1}
          aria-labelledby={`${p.id}-title`}
        >
          <div class="card__art">
            {/* Capa recortada: las formas se salen al girar y aquí es
                donde se cortan. La insignia queda fuera de este
                recorte porque en el archivo sobresale por abajo. */}
            <span class="card__clip">
              <span class="card__shape card__shape--fill">
                <img src={p.artFill} alt="" aria-hidden="true" loading="lazy" />
              </span>
              <span class="card__shape card__shape--line">
                <img src={p.artLine} alt="" aria-hidden="true" loading="lazy" />
              </span>
            </span>

            <span class="card__badge">
              <span>{p.badgeTop}</span>
              <span>{p.badgeBottom}</span>
            </span>
          </div>

          <h3 class="card__title" id={`${p.id}-title`}>
            {p.nameDisplay}
          </h3>

          <div class="card__body">
            {p.body.split('\n\n').map((para) => (
              <p>{para}</p>
            ))}
          </div>

          {/* CTA en el color contrario al bloque: verde en
              Accelerator, púrpura en Partnership. */}
          <a
            href={p.cta.href}
            class:list={['cta', p.tone === 'purple' ? 'cta--green' : 'cta--purple', 'card__cta']}
          >
            {p.cta.label}
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .programs {
    background-color: var(--surface);
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }

  .programs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 3rem);
    inline-size: min(100% - 2rem, 1241px);
    margin-inline: auto;
    /* `stretch` (por defecto) en lugar de `start`: las dos cards
       miden lo mismo de alto aunque su texto no. */
  }

  /* Rejilla de cuatro filas con la del cuerpo elástica. Como ambas
     cards se estiran a la misma altura, la fila del CTA cae a la
     misma línea en las dos — que es como está en el archivo (los
     dos botones en y=3668) y no dependía de que los textos
     midieran igual. */
  .card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
  }

  /* ---------- BLOQUE DE ARTE ---------- */

  .card__art {
    position: relative;
    aspect-ratio: 612 / 418;
  }

  .card__clip {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .card--purple .card__clip { background-color: var(--accent); }
  .card--green  .card__clip { background-color: var(--accent-2); }

  .card__shape {
    position: absolute;
    display: block;
    /* Cada capa gira desde su propio centro */
    transform-origin: 50% 50%;
    transition: transform var(--dur-slow) var(--ease-out-expo);
    will-change: transform;
  }

  .card__shape img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
  }

  /* Insets del componente de arte dentro del bloque de color.
     Accelerator: 318 × 374 en x=241 y=2880 sobre un bloque
     612 × 418 en x=99 y=2858 → 23.2% / 5.3%. */
  .card--purple .card__shape {
    inline-size: 51.96%;
    block-size: 89.42%;
    inset-inline-start: 23.2%;
    inset-block-start: 5.26%;
  }

  /* Partnership: 386 × 341 en x=840 y=2902 sobre bloque en
     x=728 y=2858 → 18.3% / 10.5%. */
  .card--green .card__shape {
    inline-size: 63.07%;
    block-size: 81.58%;
    inset-inline-start: 18.3%;
    inset-block-start: 10.53%;
  }

  /* Ángulos exactos de la variante 2 del archivo. El contorno gira
     en un sentido y el relleno en el otro: es ese cruce lo que da
     la sensación de que la figura "se abre". */
  .card--purple:hover .card__shape--fill,
  .card--purple:focus-within .card__shape--fill {
    transform: rotate(-7.21deg) scale(1.06);
  }

  .card--purple:hover .card__shape--line,
  .card--purple:focus-within .card__shape--line {
    transform: rotate(6.97deg) scale(1.06);
  }

  .card--green:hover .card__shape--fill,
  .card--green:focus-within .card__shape--fill {
    transform: rotate(-5.68deg) scale(1.05);
  }

  .card--green:hover .card__shape--line,
  .card--green:focus-within .card__shape--line {
    transform: rotate(8.74deg) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__shape {
      transition: none;
    }

    .card:hover .card__shape,
    .card:focus-within .card__shape {
      transform: none;
    }
  }

  /* ---------- INSIGNIA ----------
     130px a 74.4% del alto del bloque y 23px del borde derecho:
     queda medio dentro del color y medio sobre la barra de título.
     Va fuera del recorte del arte, por eso cuelga del .card. */
  .card__badge {
    position: absolute;
    inset-block-start: 74.4%;
    inset-inline-end: 3.76%;
    z-index: 3;
    display: grid;
    place-content: center;
    inline-size: clamp(84px, 10.5vw, 130px);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.65vw, 1.5rem); /* 24 */
    font-weight: 500;
    /* 82.9% del archivo: las dos líneas casi se tocan */
    line-height: 0.829;
    text-align: center;
  }

  /* Colores cruzados: la insignia nunca es del color de su bloque */
  .card--purple .card__badge {
    background-color: var(--accent-2);
    color: #000;
  }

  .card--green .card__badge {
    background-color: var(--accent);
    color: #fff;
  }

  /* ---------- TÍTULO ---------- */

  .card__title {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-block-size: clamp(56px, 5.3vw, 76px);
    padding: 0.5rem clamp(5rem, 12%, 8rem) 0.5rem 1rem;
    background-color: var(--brand-ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem); /* 36 */
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    color: #fff;
  }

  /* ---------- CUERPO ----------
     39px entre la barra de título y el cuerpo en el archivo
     (la barra acaba en 3350, el texto empieza en 3389). */
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 1.875rem; /* el hueco de 30px entre párrafos del archivo */
    margin-block-start: 39px;
    font-size: 1.125rem; /* 18 */
    line-height: 1.667;  /* 30/18 */
    letter-spacing: -0.36px;
    color: var(--brand-slate);
  }

  /* ---------- CTA ----------
     Colores y hover viven en las clases .cta del global; aquí solo
     su sitio dentro de la rejilla de la card. */
  .card__cta {
    justify-self: start;
    align-self: end;
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (width < 56rem) {
    .programs__grid {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 6vw, 3.5rem);
    }

    .card__title {
      padding-inline: 1rem clamp(5rem, 22%, 7rem);
    }
  }
</style>
