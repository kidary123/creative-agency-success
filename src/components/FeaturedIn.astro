---
/**
 * Featured in — banda de logos de prensa (nodo 152:209 del Figma).
 *
 * Medidas del archivo, lienzo 1440 × 334, fondo blanco:
 *   título   "Featured in", Arboria Book 20 / 30, #4D4D4D, centrado
 *   logos    fila de 6, centrada en 1241px de ancho
 *
 * Los anchos de cada logo son los del archivo: los logos de prensa
 * tienen pesos ópticos distintos y escalarlos todos igual los
 * desequilibra.
 */
import { hero } from '@/data/site';

const logos = [
  { src: '/img/press-forbes.png', alt: 'Forbes', w: 149, h: 40 },
  { src: '/img/press-abc.png', alt: 'ABC', w: 74, h: 73 },
  { src: '/img/press-entrepreneur.png', alt: 'Entrepreneur', w: 282, h: 83 },
  { src: '/img/press-nypost.png', alt: 'New York Post', w: 273, h: 39 },
  { src: '/img/press-regexseo.png', alt: 'Regex SEO', w: 210, h: 42 },
  { src: '/img/press-agencyhighway.png', alt: 'Agency Highway', w: 158, h: 52 },
];
---

<section class="press" aria-labelledby="press-heading">
  {/* PRIMER elemento de la banda blanca: así queda justo debajo del
      hombre, pegado al borde del hero, sin los logos en medio.
      Sigue perteneciendo a esta sección, no al bloque arena.

      Se alinea con el gráfico de arriba repitiendo la MISMA rejilla
      del hero (574fr / 580fr, mismo hueco y mismo ancho de
      contenedor) y colocando el texto en la segunda columna. Si se
      alineara al borde derecho del contenedor de los logos, que es
      21px más ancho, se desplazaría respecto al hombre. */}
  <div class="press__kickerrow">
    <p class="press__kicker" data-animate="fade-up">
      {hero.kickerLead} <strong>{hero.kickerStrong}</strong>
    </p>
  </div>

  <div class="press__inner">
    <h2 class="press__title" id="press-heading">Featured in</h2>

    <ul role="list" class="press__list" data-animate="stagger" data-stagger="0.06">
      {
        logos.map((logo) => (
          <li class="press__item" style={`--w:${logo.w}px`}>
            <img src={logo.src} alt={logo.alt} width={logo.w} height={logo.h} loading="lazy" />
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  /* El CTA del hero invade esta banda por arriba, así que el
     relleno superior tiene que dejarle sitio: 19px de saliente más
     el aire propio de la sección. */
  .press {
    background-color: var(--surface);
    padding-block: calc(19px + clamp(2rem, 4vw, 3.25rem)) clamp(2.5rem, 5vw, 4rem);
  }

  .press__inner {
    inline-size: min(100% - 2rem, 1241px);
    margin-inline: auto;
  }

  .press__title {
    font-size: 1.25rem; /* 20px exacto */
    line-height: 1.5;
    font-weight: 400;
    text-align: center;
    color: var(--brand-slate);
    margin-block-end: clamp(1.25rem, 2.5vw, 2.125rem);
  }

  /* Una sola fila, sin salto.
     Los seis anchos del Figma suman 1146 y el contenedor es 1241,
     así que en el archivo caben en línea con ~19px de aire. El
     problema anterior era topar por ALTO: al igualar alturas, el
     NY Post (273 × 39, muy apaisado) se iba a 364px de ancho y
     desbordaba la fila.
     Ahora manda el ANCHO — cada logo lleva su medida del archivo
     como flex-basis y solo puede encoger. Como flex-shrink reparte
     el recorte en proporción a la base, los seis mantienen entre
     sí exactamente la misma relación de tamaño a cualquier ancho
     de ventana. */
  .press__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .press__item {
    flex: 0 1 var(--w);
    min-inline-size: 0;
    display: grid;
    place-items: center;
  }

  .press__item img {
    inline-size: 100%;
    block-size: auto;
    filter: grayscale(1);
    opacity: 0.72;
    transition:
      filter var(--dur-base) var(--ease-out-quart),
      opacity var(--dur-base) var(--ease-out-quart);
  }

  .press__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  /* ---------- KICKER ----------
     Rejilla clonada del hero para que el texto caiga bajo el
     gráfico. Los valores tienen que coincidir con .hero__inner. */
  .press__kickerrow {
    display: grid;
    grid-template-columns: minmax(0, 574fr) minmax(0, 580fr);
    gap: clamp(2rem, 5vw, 4.75rem);
    inline-size: min(100% - 2rem, 1220px);
    margin-inline: auto;
    /* Separa el kicker de los logos, no del hero: va pegado arriba
       (el relleno de la sección ya deja sitio al saliente del CTA)
       y abre hueco por abajo. */
    margin-block-end: clamp(2rem, 4vw, 3.25rem);
  }

  /* Arboria 24/28 azul tinta, caja de 498 centrada en la segunda
     columna — la del hombre. */
  .press__kicker {
    grid-column: 2;
    justify-self: center;
    inline-size: min(100%, 498px);
    font-size: clamp(1.125rem, 1.67vw, 1.5rem); /* 24 */
    font-weight: 400;
    line-height: 1.167; /* 28/24 */
    text-align: center;
    color: var(--brand-ink);
  }

  .press__kicker strong {
    font-weight: 500;
  }

  /* En móvil seis en fila darían ~45px cada uno: ilegible. Se pasa
     a dos filas de tres, que es una decisión de rejilla, no un
     salto accidental. */
  /* Por debajo de 62rem el hero deja de tener dos columnas, así que
     esta rejilla tampoco tiene sentido: el texto se centra. */
  @media (width < 62rem) {
    .press__kickerrow {
      grid-template-columns: 1fr;
    }

    .press__kicker {
      grid-column: 1;
    }
  }

  @media (width < 48rem) {

    .press__list {
      flex-wrap: wrap;
      row-gap: clamp(1.5rem, 5vw, 2.25rem);
      column-gap: clamp(1.5rem, 5vw, 2.5rem);
    }

    .press__item {
      flex: 0 1 calc((100% - 2 * clamp(1.5rem, 5vw, 2.5rem)) / 3);
    }
  }
</style>
