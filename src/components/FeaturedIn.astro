---
/**
 * Featured in — banda de logos de prensa (nodo 152:209 del Figma).
 *
 * Medidas del archivo, lienzo 1440 × 334, fondo blanco:
 *   título   "Featured in", Arboria Book 20 / 30, #4D4D4D, centrado
 *   logos    fila de 6, centrada en 1241px de ancho
 *
 * Los anchos de cada logo son los del archivo: los logos de prensa
 * tienen pesos ópticos distintos y escalarlos todos igual los
 * desequilibra.
 */
const logos = [
  { src: '/img/press-forbes.png', alt: 'Forbes', w: 149, h: 40 },
  { src: '/img/press-abc.png', alt: 'ABC', w: 74, h: 73 },
  { src: '/img/press-entrepreneur.png', alt: 'Entrepreneur', w: 282, h: 83 },
  { src: '/img/press-nypost.png', alt: 'New York Post', w: 273, h: 39 },
  { src: '/img/press-regexseo.png', alt: 'Regex SEO', w: 210, h: 42 },
  { src: '/img/press-agencyhighway.png', alt: 'Agency Highway', w: 158, h: 52 },
];
---

<section class="press" aria-labelledby="press-heading">
  <div class="press__inner">
    <h2 class="press__title" id="press-heading">Featured in</h2>

    <ul role="list" class="press__list" data-animate="stagger" data-stagger="0.06">
      {
        logos.map((logo) => (
          <li class="press__item" style={`--w:${logo.w}px`}>
            <img src={logo.src} alt={logo.alt} width={logo.w} height={logo.h} loading="lazy" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .press {
    background-color: var(--surface);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .press__inner {
    inline-size: min(100% - 2rem, 1241px);
    margin-inline: auto;
  }

  .press__title {
    font-size: 1.25rem; /* 20px exacto */
    line-height: 1.5;
    font-weight: 400;
    text-align: center;
    color: var(--brand-slate);
    margin-block-end: clamp(1.25rem, 2.5vw, 2.125rem);
  }

  /* Una sola fila, sin salto.
     Los seis anchos del Figma suman 1146 y el contenedor es 1241,
     así que en el archivo caben en línea con ~19px de aire. El
     problema anterior era topar por ALTO: al igualar alturas, el
     NY Post (273 × 39, muy apaisado) se iba a 364px de ancho y
     desbordaba la fila.
     Ahora manda el ANCHO — cada logo lleva su medida del archivo
     como flex-basis y solo puede encoger. Como flex-shrink reparte
     el recorte en proporción a la base, los seis mantienen entre
     sí exactamente la misma relación de tamaño a cualquier ancho
     de ventana. */
  .press__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .press__item {
    flex: 0 1 var(--w);
    min-inline-size: 0;
    display: grid;
    place-items: center;
  }

  .press__item img {
    inline-size: 100%;
    block-size: auto;
    filter: grayscale(1);
    opacity: 0.72;
    transition:
      filter var(--dur-base) var(--ease-out-quart),
      opacity var(--dur-base) var(--ease-out-quart);
  }

  .press__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  /* En móvil seis en fila darían ~45px cada uno: ilegible. Se pasa
     a dos filas de tres, que es una decisión de rejilla, no un
     salto accidental. */
  @media (width < 48rem) {
    .press__list {
      flex-wrap: wrap;
      row-gap: clamp(1.5rem, 5vw, 2.25rem);
      column-gap: clamp(1.5rem, 5vw, 2.5rem);
    }

    .press__item {
      flex: 0 1 calc((100% - 2 * clamp(1.5rem, 5vw, 2.5rem)) / 3);
    }
  }
</style>
