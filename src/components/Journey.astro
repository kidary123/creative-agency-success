---
/**
 * The Journey To Your Sucess — acordeón de siete retratos.
 * Component 9 del Figma (85:465) con sus ocho variantes:
 * Frame 11 es el estado colapsado y Frame 13..19 los expandidos.
 *
 * Comportamiento del archivo:
 *   colapsado   7 columnas iguales, gap 16, banda de 488px
 *   hover       el slot pasa a 520px y los demás bajan a ~137px;
 *               bajo la foto aparece un panel #F4F1EF con el valor
 *               (32px), dos párrafos (16/1.5) y un CTA azul tinta
 *               de 51px; la banda crece a 780px
 *
 * Los anchos salen exactos de la aritmética del archivo: en 1440px
 * con 6 huecos de 16 quedan 1344 útiles. Un slot a 520 deja 824 para
 * los otros seis = 137,33 cada uno — que es justo el valor que trae
 * la variante. Por eso el flex-grow del expandido es 520/137,33.
 *
 * Accesibilidad: el panel no depende solo de :hover. Cada slot lleva
 * un botón real, así que :focus-within lo abre con teclado, y en
 * pantallas táctiles la sección se convierte en tarjetas apiladas
 * con el texto siempre visible.
 */
import Picture from '@components/Picture.astro';
import { journey } from '@/data/site';

/**
 * El archivo expande a 520px sobre 1440 (ratio 3.787 frente a los
 * otros seis). A ancho completo de ventana eso se dispara: en 1920px
 * el slot pasaría de 740 y la banda de 780 de alto se come la
 * pantalla. Se baja el ratio y se topa el ancho, y al expandirse la
 * foto gira a formato horizontal — así el bloque ocupa bastante
 * menos alto sin perder la idea del diseño.
 */
const EXPANDIDO = 2.6;
---

<section class="journey" id="success-stories" aria-labelledby="journey-heading">
  <div class="journey__intro">
    <h2 class="journey__title" id="journey-heading" data-animate="fade-up">
      {journey.headingDisplay}
    </h2>
    <p class="journey__copy" data-animate="fade-up" data-delay="0.08">
      {journey.body}
    </p>
  </div>

  <ul role="list" class="journey__strip" style={`--expandido:${EXPANDIDO}`}>
    {
      journey.portraits.map((p, i) => (
        <li class="slot" style={`--offset:${p.offset}`}>
          <div class="slot__media">
            <Picture src={p.src} alt={p.alt} width={210} height={406} focus={p.focus} />
          </div>

          <div class="slot__panel" id={`journey-panel-${i}`}>
            <h3 class="slot__title">{p.title}</h3>
            {p.body.map((para) => (
              <p class="slot__text">{para}</p>
            ))}
            <a href={journey.cta.href} class="slot__cta" tabindex="-1">
              {journey.cta.label}
            </a>
          </div>

          {/* Botón real: da foco por teclado y anuncia el panel.
              Se estira sobre la foto para que el hover del ratón y
              el foco del teclado abran exactamente lo mismo. */}
          <button class="slot__trigger" type="button" aria-expanded="false" aria-controls={`journey-panel-${i}`}>
            <span class="visually-hidden">{p.correct}</span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<script>
  // El estado visual lo lleva el CSS. Esto solo mantiene aria-expanded
  // sincronizado, que es lo que leen los lectores de pantalla.
  document.querySelectorAll<HTMLLIElement>('.journey__strip .slot').forEach((slot) => {
    const trigger = slot.querySelector<HTMLButtonElement>('.slot__trigger');
    const cta = slot.querySelector<HTMLAnchorElement>('.slot__cta');
    if (!trigger) return;

    const strip = slot.closest<HTMLUListElement>('.journey__strip');
    const panel = slot.querySelector<HTMLDivElement>('.slot__panel');

    /**
     * El panel está posicionado en absoluto bajo la foto, así que no
     * suma altura a la banda: se salía por abajo y se montaba encima
     * de "Featured in". Un min-height fijo no vale, porque el panel
     * mide distinto en cada slot (los textos no tienen el mismo
     * largo) y además cambia con el ancho de ventana.
     *
     * Se mide el panel una vez abierto y se reserva esa altura en la
     * banda. Así la sección de abajo se desplaza justo lo necesario.
     */
    const reservarAlto = (abierto: boolean) => {
      if (!strip || !panel) return;

      if (!abierto) {
        strip.style.minBlockSize = '';
        return;
      }

      // En el siguiente frame el panel ya tiene su altura real.
      requestAnimationFrame(() => {
        const fondoPanel = panel.getBoundingClientRect().bottom;
        const topBanda = strip.getBoundingClientRect().top;
        strip.style.minBlockSize = `${Math.ceil(fondoPanel - topBanda)}px`;
      });
    };

    const marcar = (abierto: boolean) => {
      trigger.setAttribute('aria-expanded', String(abierto));
      // El CTA solo es alcanzable con Tab cuando el panel está abierto.
      cta?.setAttribute('tabindex', abierto ? '0' : '-1');
      reservarAlto(abierto);
    };

    slot.addEventListener('mouseenter', () => marcar(true));
    slot.addEventListener('mouseleave', () => marcar(false));
    slot.addEventListener('focusin', () => marcar(true));
    slot.addEventListener('focusout', (event) => {
      if (!slot.contains(event.relatedTarget as Node)) marcar(false);
    });
  });
</script>

<style>
  .journey {
    background-color: var(--surface);
    padding-block: clamp(3rem, 6vw, 5.5rem) 0;
    /* Sin esto el panel, que sobresale por abajo, se pintaría sobre
       la banda de logos aunque la altura ya esté reservada. */
    position: relative;
    z-index: 1;
  }

  .journey__intro {
    inline-size: min(100% - 2rem, 720px);
    margin-inline: auto;
    text-align: center;
  }

  .journey__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--brand-ink);
  }

  .journey__copy {
    margin-block-start: clamp(0.75rem, 1.5vw, 1.25rem);
    font-size: 1.125rem;
    line-height: 1.667;
    letter-spacing: -0.36px;
    color: var(--brand-slate);
  }

  /* ---------- BANDA A SANGRE ----------
     Ocupa el ancho completo de la ventana, no el del contenedor.
     El 100vw + centrado por margen negativo evita la barra de
     scroll horizontal que da `width:100vw` a secas. */
  .journey__strip {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;

    inline-size: 100vw;
    margin-inline-start: 50%;
    translate: -50% 0;

    /* Colapsada usa la altura del archivo. Expandida crece lo justo
       para el panel, no los 780 del Figma: con la foto en horizontal
       el bloque cabe en mucho menos. */
    min-block-size: clamp(320px, 34vw, 488px);
    transition: min-block-size var(--dur-slow) var(--ease-out-expo);
  }

  .journey__strip:hover,
  .journey__strip:focus-within {
    min-block-size: clamp(420px, 40vw, 580px);
  }

  /* ---------- SLOT ---------- */

  .slot {
    position: relative;
    flex: 1 1 0;
    min-inline-size: 0;
    /* El escalonado del archivo, proporcional a la banda de 489 */
    margin-block-start: calc(var(--offset) / 489 * clamp(320px, 34vw, 488px));
    transition:
      flex-grow var(--dur-slow) var(--ease-out-expo),
      margin-block-start var(--dur-slow) var(--ease-out-expo);
  }

  .slot:hover,
  .slot:focus-within {
    flex-grow: var(--expandido);
    /* Tope duro: sin esto, en una pantalla de 2560 el slot expandido
       se iría por encima de 900px y rompería la proporción. */
    max-inline-size: 460px;
    /* Sube a ras del resto: mantener el escalonado en el expandido
       sumaba hasta 140px de alto que no aporta nada. */
    margin-block-start: 0;
  }

  /* Retrato en reposo, horizontal al expandirse. El giro de formato
     es lo que recorta el alto del bloque: la foto pasa de 348 de
     alto a poco más de la mitad. */
  .slot__media {
    aspect-ratio: 180 / 348;
    overflow: hidden;
    transition: aspect-ratio var(--dur-slow) var(--ease-out-expo);
  }

  .slot:hover .slot__media,
  .slot:focus-within .slot__media {
    aspect-ratio: 16 / 10;
  }

  .slot__media :global(picture),
  .slot__media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* El botón cubre la foto: hover de ratón y foco de teclado
     disparan el mismo estado. */
  .slot__trigger {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 100%;
    z-index: 2;
    cursor: pointer;
  }

  .slot:has(.slot__trigger:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------- PANEL ---------- */

  .slot__panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    z-index: 1;
    padding: 20px 26px 24px;
    background-color: var(--brand-sand);
    opacity: 0;
    visibility: hidden;
    translate: 0 -12px;
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out-quart),
      translate var(--dur-slow) var(--ease-out-expo),
      visibility 0s linear var(--dur-base);
  }

  .slot:hover .slot__panel,
  .slot:focus-within .slot__panel {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    pointer-events: auto;
    transition-delay: 0s, 0s, 0s;
  }

  /* El contenido solo aparece cuando el slot ya es ancho: si se
     revela a la vez que la expansión, el texto se ve reflowear. */
  .slot__title,
  .slot__text,
  .slot__cta {
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out-quart) 0.12s;
  }

  .slot:hover :is(.slot__title, .slot__text, .slot__cta),
  .slot:focus-within :is(.slot__title, .slot__text, .slot__cta) {
    opacity: 1;
  }

  /* Tipografía algo más compacta que los 32/16 del archivo: a 460px
     de ancho, el tamaño original hacía un panel más alto que la
     propia foto. */
  .slot__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
    color: #000;
    margin-block-end: 0.875rem;
  }

  .slot__text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #000;
  }

  .slot__text + .slot__text {
    margin-block-start: 0.85rem;
  }

  .slot__cta {
    display: inline-grid;
    place-items: center;
    inline-size: 128px;
    min-block-size: 46px;
    margin-block-start: 1.25rem;
    background-color: var(--brand-ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: #fff;
    position: relative;
    z-index: 3;
    transition:
      opacity var(--dur-base) var(--ease-out-quart) 0.12s,
      transform var(--dur-base) var(--ease-out-expo);
  }

  .slot__cta:hover {
    transform: translateY(-2px);
  }

  /* ---------- TÁCTIL Y MÓVIL ----------
     Un acordeón por hover no existe en táctil. Por debajo de 62rem
     se convierte en tarjetas apiladas con el texto siempre visible:
     misma información, sin depender de un puntero. */
  @media (width < 62rem), (hover: none) {
    .journey__strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
      gap: clamp(1.5rem, 4vw, 2.5rem);
      inline-size: min(100% - 2rem, 1100px);
      margin-inline: auto;
      translate: none;
      min-block-size: 0;
      padding-block-end: clamp(2rem, 5vw, 3.5rem);
    }

    .journey__strip:hover,
    .journey__strip:focus-within {
      min-block-size: 0;
    }

    .slot,
    .slot:hover,
    .slot:focus-within {
      flex: none;
      margin-block-start: 0;
    }

    .slot__trigger {
      display: none;
    }

    .slot__panel {
      position: static;
      opacity: 1;
      visibility: visible;
      translate: none;
      pointer-events: auto;
      padding-inline: 0;
    }

    .slot__title,
    .slot__text,
    .slot__cta {
      opacity: 1;
    }

    .slot__title {
      margin-block-end: 1rem;
    }

    .slot__cta {
      margin-block-start: 1.5rem;
    }
  }
</style>
