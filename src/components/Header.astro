---
/**
 * Header / nav — logo, enlaces ancla y CTA.
 * En móvil los enlaces colapsan en un panel desplegable.
 */
import Logo from '@components/Logo.astro';
import { navLinks } from '@/data/site';
---

<header class="header" data-nav>
  <div class="wrap wrap--wide header__inner">
    <Logo tone="light" />

    <nav class="header__nav" id="primary-nav" aria-label="Primary">
      <ul role="list" class="header__list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="header__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href="#contact" class="btn btn--accent header__cta">Book A Call</a>

      <button
        type="button"
        class="header__toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="visually-hidden">Menu</span>
        <span class="header__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const header = document.querySelector<HTMLElement>('[data-nav]');

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // Cierra el panel al navegar a un ancla
  header?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-sticky);
    padding-block: var(--space-xs);
    color: var(--n-0);
    transition:
      padding-block var(--dur-base) var(--ease-out-expo),
      background-color var(--dur-base) var(--ease-out-quart),
      box-shadow var(--dur-base) var(--ease-out-quart);
  }

  .header:global(.is-scrolled) {
    padding-block: var(--space-3xs);
    background-color: oklch(from var(--brand-ink) l c h / 0.86);
    backdrop-filter: blur(18px) saturate(1.5);
    box-shadow: 0 1px 0 oklch(from var(--n-0) l c h / 0.10);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__link {
    position: relative;
    font-size: var(--step--1);
    font-weight: 500;
    color: oklch(from var(--n-0) l c h / 0.78);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  .header__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.4em;
    block-size: 2px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--n-0);
  }

  .header__link:hover::after,
  .header__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* Botón hamburguesa — tres barras hechas con una sola caja */
  .header__toggle {
    display: none;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-s);
    border: 1px solid oklch(from var(--n-0) l c h / 0.22);
    color: var(--n-0);
  }

  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    inline-size: 1.05rem;
    block-size: 2px;
    border-radius: var(--radius-full);
    background-color: currentColor;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  .header__bars::before,
  .header__bars::after {
    content: '';
    position: absolute;
  }

  .header__bars::before { transform: translateY(-6px); }
  .header__bars::after  { transform: translateY(6px); }

  .header:global(.is-open) .header__bars {
    background-color: transparent;
  }

  .header:global(.is-open) .header__bars::before {
    transform: rotate(45deg);
  }

  .header:global(.is-open) .header__bars::after {
    transform: rotate(-45deg);
  }

  @media (width < 64rem) {
    .header__toggle {
      display: grid;
      position: relative;
    }

    .header__nav {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: var(--gutter);
      padding: var(--space-s);
      border-radius: var(--radius-m);
      background-color: var(--brand-ink-2);
      box-shadow: var(--shadow-l);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition:
        opacity var(--dur-fast) var(--ease-out-quart),
        transform var(--dur-fast) var(--ease-out-expo),
        visibility var(--dur-fast);
    }

    .header:global(.is-open) .header__nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .header__list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2xs);
    }

    .header__link {
      display: block;
      padding-block: var(--space-2xs);
      font-size: var(--step-0);
    }

    .header__link::after {
      display: none;
    }
  }

  @media (width < 30rem) {
    .header__cta {
      display: none;
    }
  }
</style>
