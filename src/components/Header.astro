---
/**
 * Header — reconstruido desde el Figma (nodo 640:3463 / Component 48).
 *
 * Medidas del archivo, sobre un lienzo de 1440 × 139:
 *   banda        #F4F1EF, sombra 0 4px 20px -2px rgba(0,0,0,.07)
 *   logo         x=110  y=12   110 × 110
 *   nav          x=296  y=47   1048 × 46, alineada a la derecha, gap 49
 *   enlaces      Arboria Medium 16 / #021E46
 *   búsqueda     53 × 46, radio 7, icono 26.5 × 27.5
 *
 * Traducido a un layout fluido: los 49px de gap y el 16px de los
 * enlaces se conservan tal cual; el posicionamiento absoluto del
 * Figma se convierte en flex, que es lo que hace que aguante el
 * responsive sin reventar.
 */
import { navLinks } from '@/data/site';
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Creative Agency Success — inicio">
      <img src="/img/logo.svg" alt="Creative Agency Success" width="110" height="110" />
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      <ul role="list" class="nav__list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="nav__link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button class="nav__search" type="button" aria-label="Buscar">
        <img src="/img/icon-search.svg" alt="" width="27" height="28" aria-hidden="true" />
      </button>
    </nav>

    <button class="nav__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
      <span class="visually-hidden">Abrir menú</span>
      <span class="nav__burger-bar" aria-hidden="true"></span>
      <span class="nav__burger-bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav__mobile" id="mobile-menu" data-menu hidden>
    <ul role="list" class="nav__mobile-list">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav__mobile-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Al pulsar un enlace del panel, ciérralo: en móvil son anclas
  // y dejar el panel abierto tapa justo lo que acabas de pedir.
  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      toggle?.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      document.body.style.overflow = '';
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    background-color: var(--brand-sand);
    box-shadow: var(--shadow-figma);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    inline-size: min(100% - 2rem, 1440px);
    margin-inline: auto;
    /* 110px de logo + 12/17 de aire arriba y abajo = 139 de alto */
    padding-block: 0.75rem 1.0625rem;
    padding-inline: clamp(1rem, 7.64vw, 110px) clamp(1rem, 6.9vw, 99px);
  }

  .nav__brand {
    display: block;
    flex-shrink: 0;
    line-height: 0;
  }

  .nav__brand img {
    inline-size: clamp(72px, 7.6vw, 110px);
    block-size: auto;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3.4vw, 49px);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3.4vw, 49px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    font-size: 1rem; /* 16px, exacto del Figma */
    font-weight: 500;
    color: var(--brand-ink);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }

  /* Subrayado que se dibuja al hover — el Figma no lo especifica,
     pero un enlace sin estado hover se siente muerto. Usa el púrpura
     de marca, así que no introduce color nuevo. */
  .nav__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.35em;
    block-size: 2px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__search {
    display: grid;
    place-items: center;
    inline-size: 53px;
    block-size: 46px;
    flex-shrink: 0;
    border-radius: 7px;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.07));
    transition: transform var(--dur-fast) var(--ease-spring);
  }

  .nav__search img {
    inline-size: 27px;
    block-size: 28px;
  }

  .nav__search:hover {
    transform: scale(1.08);
  }

  /* ---------- MÓVIL ---------- */

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    inline-size: 44px;
    block-size: 44px;
    flex-shrink: 0;
  }

  .nav__burger-bar {
    display: block;
    inline-size: 26px;
    block-size: 2px;
    margin-inline: auto;
    border-radius: var(--radius-full);
    background-color: var(--brand-ink);
    transition: transform var(--dur-base) var(--ease-out-expo);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bar:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .nav__burger[aria-expanded='true'] .nav__burger-bar:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .nav__mobile {
    background-color: var(--brand-sand);
    border-block-start: 1px solid oklch(from var(--brand-ink) l c h / 0.08);
  }

  .nav__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin: 0;
    padding: var(--space-m) clamp(1rem, 6vw, 3rem) var(--space-l);
    list-style: none;
  }

  .nav__mobile-link {
    display: block;
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--brand-ink);
  }

  @media (width < 68rem) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: flex;
    }
  }

  @media (width >= 68rem) {
    .nav__mobile {
      display: none;
    }
  }
</style>
