---
interface Props {
  /** Fuerza el color del texto; por defecto hereda del contenedor */
  tone?: 'light' | 'dark' | 'inherit';
}

const { tone = 'inherit' } = Astro.props;
---

<a href="#main" class="logo" data-tone={tone} aria-label="Creative Agency Success — home">
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path
        d="M16 3 4 27h6.2l2.1-4.4h7.4L21.8 27H28L16 3Zm-1.5 14.4L16 14l1.5 3.4h-3Z"
        fill="currentColor"
      />
    </svg>
  </span>
  <span class="logo__text">
    <span class="logo__line">Creative Agency</span>
    <span class="logo__line logo__line--accent">Success</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .logo__mark {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-s);
    background-color: var(--accent);
    color: var(--accent-ink);
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .logo__mark svg {
    inline-size: 1.15rem;
    block-size: 1.15rem;
  }

  .logo:hover .logo__mark {
    transform: rotate(-8deg) scale(1.06);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
  }

  .logo__line--accent {
    color: var(--accent);
  }

  .logo[data-tone='light'] {
    color: var(--n-0);
  }

  .logo[data-tone='dark'] {
    color: var(--brand-ink);
  }
</style>
